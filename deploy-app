#!/bin/sh
set -eu

COMPOSE_FILES="-f docker-compose.yml -f docker-compose.prod.yml"
APP_IMAGE="smeta-expert-runtime:latest"
SPA_IMAGE="smeta-expert-spa:latest"

SKIP_MIGRATIONS=0
case "${1:-}" in
  '') ;;
  --skip-migrate) SKIP_MIGRATIONS=1 ;;
  *) echo "Usage: ./deploy-app [--skip-migrate]" >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then
  echo "Usage: ./deploy-app [--skip-migrate]" >&2
  exit 2
fi

if [ ! -f ./.deploy.env ]; then
  echo "ERROR: .deploy.env not found"
  exit 1
fi

set -a
. ./.deploy.env
set +a

OLD_HEAD=$(git rev-parse HEAD 2>/dev/null || true)
git pull --ff-only
NEW_HEAD=$(git rev-parse HEAD 2>/dev/null || true)

CHANGED_FILES=""
if [ -n "$OLD_HEAD" ] && [ -n "$NEW_HEAD" ] && [ "$OLD_HEAD" != "$NEW_HEAD" ]; then
  CHANGED_FILES=$(git diff --name-only "$OLD_HEAD" "$NEW_HEAD")
fi

BUILD_APP=0
BUILD_SPA=0

# Rebuild a service only when its image is missing or an image input changed.
# Regular Laravel/PHP source files are bind-mounted from ./server and do not
# require rebuilding the large runtime image.
if ! docker image inspect "$APP_IMAGE" >/dev/null 2>&1; then
  BUILD_APP=1
fi
if ! docker image inspect "$SPA_IMAGE" >/dev/null 2>&1; then
  BUILD_SPA=1
fi

if [ -n "$CHANGED_FILES" ]; then
  echo "Changed files since previous deploy:"
  printf '%s\n' "$CHANGED_FILES"

  while IFS= read -r path; do
    case "$path" in
      docker/app/*|docker/certificates/*|server/composer.json|server/composer.lock)
        BUILD_APP=1
        ;;
      client/*|docker/spa/*)
        BUILD_SPA=1
        ;;
    esac
  done <<EOF
$CHANGED_FILES
EOF
fi

if [ "$BUILD_APP" -eq 1 ]; then
  echo "Building shared app/worker runtime image..."
  docker compose $COMPOSE_FILES build app
else
  echo "Skipping app/worker image build: runtime image inputs unchanged"
fi

if [ "$BUILD_SPA" -eq 1 ]; then
  echo "Building SPA image..."
  docker compose $COMPOSE_FILES build spa
else
  echo "Skipping SPA image build: client image inputs unchanged"
fi

# Images are built explicitly above. --no-build prevents Compose from
# rebuilding unrelated services during the startup/reconcile phase.
docker compose $COMPOSE_FILES up -d --no-build

# The server bind mount covers image-built vendor; reconcile it with the checked-out lockfile.
docker compose $COMPOSE_FILES exec -T app composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction
docker compose $COMPOSE_FILES exec -T app composer check-platform-reqs --no-dev
docker compose $COMPOSE_FILES exec -T worker composer check-platform-reqs --no-dev
app_vendor=$(docker compose $COMPOSE_FILES exec -T app sha256sum /var/www/html/vendor/composer/installed.php)
worker_vendor=$(docker compose $COMPOSE_FILES exec -T worker sha256sum /var/www/html/vendor/composer/installed.php)
if [ -z "$app_vendor" ] || [ "$app_vendor" != "$worker_vendor" ]; then
  echo "ERROR: app and worker Composer runtime differs" >&2
  exit 1
fi
docker compose $COMPOSE_FILES exec -T app php -r 'require "/var/www/html/vendor/autoload.php"; exit(class_exists("Smalot\\PdfParser\\Parser") ? 0 : 1);'
docker compose $COMPOSE_FILES exec -T worker php -r 'require "/var/www/html/vendor/autoload.php"; exit(class_exists("Smalot\\PdfParser\\Parser") ? 0 : 1);'

# Restart long-lived processes so they load the newly reconciled vendor tree.
docker compose $COMPOSE_FILES restart app worker

# Browser libraries are baked into the runtime image. Browser binaries live in
# the persistent playwright_browsers volume, so this command is cheap when the
# required Chromium revision is already present and downloads only when needed.
docker compose $COMPOSE_FILES exec -T worker sh -lc '
cd /var/www/html

if ! npm ls playwright @playwright/test >/dev/null 2>&1; then
  echo "ERROR: Playwright package is not installed in worker container"
  exit 1
fi

npx playwright install chromium
'

# Backup DB before any schema changes.
./backup-db.sh

# Sanity check: critical tables must exist before running migrations.
docker compose $COMPOSE_FILES exec -T db sh -lc '
mysql -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" "$MYSQL_DATABASE" -Nse "
SELECT COUNT(*)
FROM information_schema.tables
WHERE table_schema = '\''$MYSQL_DATABASE'\''
  AND table_name IN ('\''users'\'','\''projects'\'','\''materials'\'');
"
' | {
  read count
  if [ "$count" -lt 3 ]; then
    echo "ERROR: critical tables missing in database. Aborting deploy."
    exit 1
  fi
}

if [ "$SKIP_MIGRATIONS" -eq 1 ]; then
  echo "Migrations skipped by request"
else
  docker compose $COMPOSE_FILES exec -T app sh -lc "DB_USERNAME=$MIGRATION_DB_USERNAME DB_PASSWORD=$MIGRATION_DB_PASSWORD php artisan migrate --force"
fi

docker compose $COMPOSE_FILES exec -T app php artisan optimize:clear
docker compose $COMPOSE_FILES exec -T app php artisan config:cache
docker compose $COMPOSE_FILES exec -T app php artisan route:cache
docker compose $COMPOSE_FILES exec -T app php artisan view:cache

echo "Waiting for smeta_app to become healthy..."
APP_OK=0
for i in $(seq 1 60); do
  status=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}no-healthcheck{{end}}' smeta_app 2>/dev/null || true)
  if [ "$status" = "healthy" ]; then
    APP_OK=1
    echo "smeta_app is healthy"
    break
  fi
  echo "Attempt $i/60: smeta_app status = $status"
  sleep 2
done

if [ "$APP_OK" -ne 1 ]; then
  echo "ERROR: smeta_app did not become healthy in time"
  exit 1
fi

echo "Giving services a few extra seconds..."
sleep 5

echo "Restarting web container..."
docker compose $COMPOSE_FILES restart web

echo "Checking site availability..."
SITE_OK=0
for i in $(seq 1 30); do
  if docker compose $COMPOSE_FILES exec -T web sh -lc "wget -q -O /dev/null http://127.0.0.1/"; then
    SITE_OK=1
    echo "Site is up"
    break
  fi
  echo "Attempt $i/30: waiting for site..."
  sleep 2
done

if [ "$SITE_OK" -ne 1 ]; then
  echo "ERROR: site did not become available in time"
  exit 1
fi

# Remove the old per-service image tags left by the previous Compose layout.
# Docker refuses to remove an image that is still used by a running container,
# so this is safe to repeat on later deployments.
echo "Removing legacy Prism image tags..."
docker image rm \
  smeta-expert-server-app:latest \
  smeta-expert-server-worker:latest \
  smeta-expert-server-spa:latest \
  >/dev/null 2>&1 || true

# Keep a bounded cache on the 50 GB VPS instead of deleting it after every
# deployment. This preserves the expensive PHP/apt/Composer layers while
# preventing build cache from growing without limit.
echo "Limiting Docker build cache to about 5 GB..."
docker builder prune -f --keep-storage 5GB || true

# Remove old untagged image layers after containers have switched to the new
# images. Active/tagged application images are not removed by this command.
echo "Removing dangling Docker images..."
docker image prune -f || true

echo "Disk usage after deploy:"
df -h / || true

echo "Deploy completed successfully"
