# Development Environment Variables

# API Base URL (Laravel backend)
# Для Docker: http://localhost:8000
# Для XAMPP: http://localhost/smeta-expert-server/server/public
# Попробуем через прокси Vite сначала
VITE_API_URL=/
VITE_APP_ENV=development
VITE_BILLING_ENABLED=false
VITE_BILLING_USER_UI_ENABLED=false
VITE_BILLING_ADMIN_UI_ENABLED=true
VITE_BILLING_CHECKOUT_ENABLED=false
VITE_BILLING_ENFORCEMENT_ENABLED=false

# DEV-ONLY: enables mock auth and read-only demo API responses for UI visual acceptance.
# Keep disabled by default. Never enable in production builds.
VITE_ENABLE_DEV_VISUAL_AUTH=false
