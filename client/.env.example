# ========== Frontend ==========
# Базовый URL API. Для production обычно достаточно /api, если backend доступен на том же домене.
VITE_API_URL=/api

# Название приложения и режим сборки frontend.
VITE_APP_NAME=ПРИЗМА
VITE_APP_ENV=production

# DEV-ONLY: включает mock auth и demo API для визуальной проверки UI.
# В production должно быть false.
VITE_ENABLE_DEV_VISUAL_AUTH=false
