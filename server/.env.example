APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
PUBLIC_VERIFY_BASE_URL=https://verify.prismcore.ru

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# ── SMTP settings (fill with real credentials for production) ──────────────────
# Timeweb SMTP: host=smtp.timeweb.ru, port=465 (SSL) or 587 (TLS/STARTTLS)
# Standard SMTP example — replace values before deploying:
MAIL_SCHEME=ssl
MAIL_HOST=smtp.timeweb.ru
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.ru
MAIL_PASSWORD=your-smtp-password-here
MAIL_FROM_ADDRESS="noreply@yourdomain.ru"
MAIL_FROM_NAME="${APP_NAME}"
# ── Local development override ─────────────────────────────────────────────────
# To use log driver in dev (no real emails sent), set MAIL_MAILER=log above.
# To use Mailpit/Mailtrap in dev: MAIL_MAILER=smtp MAIL_HOST=localhost MAIL_PORT=1025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ========== Evidence Pipeline ==========
# Staged rollout flags for price evidence. All default to false.
# See README_DEPLOY.md "Evidence Feature Rollout" for activation order.
EVIDENCE_PIPELINE_V2=false
EVIDENCE_FACADE_ENABLED=false
EVIDENCE_OPERATIONS_ENABLED=false
EVIDENCE_LABOR_WORK_ENABLED=false
EVIDENCE_EXPENSES_ENABLED=false
EVIDENCE_EXPENSES_DOCUMENT_ENABLED=false
EVIDENCE_CHROME_REVISION_ENABLED=false
EVIDENCE_GENERIC_CHROME_ENABLED=false

# ========== Hidden Billing Foundation ==========
BILLING_ENABLED=false
BILLING_CHECKOUT_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false
BILLING_USER_UI_ENABLED=false
BILLING_ADMIN_UI_ENABLED=true
BILLING_USAGE_TRACKING_ENABLED=true
BILLING_PROVIDER=yookassa
BILLING_PROVIDER_MODE=test
BILLING_TRACK_USAGE=true
BILLING_ENFORCE_LIMITS=false
BILLING_LOG_ONLY=true
BILLING_FAIL_OPEN=true
BILLING_DEFAULT_PLAN=legacy_unlimited
BILLING_STORAGE_TRACKING_ENABLED=false
BILLING_PAYMENTS_ENABLED=false
BILLING_CHECKOUT_UI_ENABLED=false
BILLING_PROVIDER_DEFAULT=yookassa
BILLING_PROVIDER_YOOKASSA_ENABLED=false
BILLING_PROVIDER_YOOKASSA_MODE=test

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_API_BASE=https://api.yookassa.ru/v3
BILLING_YOOKASSA_RECEIPTS_ENABLED=true
BILLING_YOOKASSA_RECEIPT_VAT_CODE=1
BILLING_YOOKASSA_RECEIPT_PAYMENT_SUBJECT=service
BILLING_YOOKASSA_RECEIPT_PAYMENT_MODE=full_prepayment

# ========== LLM Providers ==========
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

ROUTERAI_API_KEY=
ROUTERAI_MODEL=openai/gpt-4o
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# ========== Phone Auth: Telegram Gateway ==========
TELEGRAM_GATEWAY_ENABLED=false
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_GATEWAY_TEST_MODE=true

# ========== Phone Auth: SMS.ru CallCheck ==========
SMSRU_ENABLED=false
SMSRU_API_ID=12D5ADD2-C648-FC86-1981-F0E348498800
SMSRU_CALLCHECK_TIMEOUT=15
SMSRU_CALLCHECK_TEST_CONFIRMED=true
SMSRU_CALLCHECK_WEBHOOK_ENABLED=true
SMSRU_CALLCHECK_WEBHOOK_TOKEN=

SMSRU_CALLCHECK_TEST_PHONE=74995555555
SMSRU_CALLCHECK_TEST_PHONE_PRETTY="+7 (499) 555-5555"
SMSRU_OFFICIAL_LIBRARY_ENABLED=false
SMSRU_OFFICIAL_LIBRARY_PATH="/var/www/html/integrations/smsru/official/sms.ru.php"
SMSRU_OFFICIAL_LIBRARY_CLASS=SMSRU

# ========== Verification Code Settings ==========
VERIFICATION_CODE_TTL=5
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN=60
VERIFICATION_TEST_MODE=true
VERIFICATION_TEST_CODE=

